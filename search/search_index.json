{"config":{"lang":["en"],"separator":"[\\s\\u200b\\u3000\\-\u3001\u3002\uff0c\uff0e\uff1f\uff01\uff1b]+","pipeline":["stemmer"],"fields":{"title":{"boost":1000.0},"text":{"boost":1.0},"tags":{"boost":1000000.0}}},"docs":[{"location":"","title":"\u6b22\u8fce\u6765\u5230 axdd \u7684\u4e2a\u4eba\u535a\u5ba2","text":""},{"location":"#_1","title":"\u5173\u4e8e\u672c\u4eba","text":"<ul> <li>\u4e3b\u4e1a\u751f\u7269\uff0c\u526f\u4e1a\u8ba1\u7b97\uff0c\u5174\u8da3\u6570\u5b66</li> <li>\u6b63\u5728\u8270\u96be\u7684\u548c\u8bfb\u7814\u640f\u6597</li> <li>\u5e76\u4e14\u76f4\u5230\u73b0\u5728\u8fd8\u6ca1\u6709\u8d62\u8fc7</li> </ul>"},{"location":"#_2","title":"\u5173\u4e8e\u672c\u7ad9","text":"<ul> <li>\u672c\u7ad9\u4f7f\u7528\u4e86squidfunk\u7684material\u535a\u5ba2\u6a21\u677f</li> <li>\u672c\u7ad9\u4e3b\u8981\u6536\u5f55\u751f\u7269\u3001\u8ba1\u7b97\u76f8\u5173\u7684\u7ecf\u9a8c\u548c\u5b66\u4e60\u5fc3\u5f97\uff0c\u4ee5\u53ca\u4e2a\u4eba\u788e\u788e\u5ff5</li> </ul>"},{"location":"#_3","title":"\u8054\u7cfb\u6211","text":"<ul> <li>github\u4e3b\u9875</li> <li>\u4e2a\u4eba\u90ae\u7bb1</li> <li>\u4ee5\u53ca\u7f18\u5206</li> </ul>"},{"location":"blog/","title":"\u6700\u8fd1\u66f4\u65b0 | Recent","text":""},{"location":"blog/collections/","title":"\u5408\u8f91 | Collections","text":""},{"location":"blog/collections/#_1","title":"\u521d\u7aa5\u5bf9\u5076","text":"<ul> <li>\u4e0a\u4e0b\u6781\u9650\u70b9\u4e0e\u6700\u5c0f\u6700\u5927\u4e0d\u7b49\u5f0f</li> </ul>"},{"location":"blog/tags/","title":"\u6807\u7b7e | Tags","text":""},{"location":"blog/tags/#tag:math","title":"math","text":"<ul> <li>            \u4e0a\u4e0b\u6781\u9650\u70b9\u4e0e\u6700\u5c0f\u6700\u5927\u4e0d\u7b49\u5f0f          </li> </ul>"},{"location":"blog/2026/10/11/%E4%B8%8A%E4%B8%8B%E6%9E%81%E9%99%90%E7%82%B9%E4%B8%8E%E6%9C%80%E5%B0%8F%E6%9C%80%E5%A4%A7%E4%B8%8D%E7%AD%89%E5%BC%8F/","title":"\u4e0a\u4e0b\u6781\u9650\u70b9\u4e0e\u6700\u5c0f\u6700\u5927\u4e0d\u7b49\u5f0f","text":"","tags":["math"]},{"location":"blog/2026/10/11/%E4%B8%8A%E4%B8%8B%E6%9E%81%E9%99%90%E7%82%B9%E4%B8%8E%E6%9C%80%E5%B0%8F%E6%9C%80%E5%A4%A7%E4%B8%8D%E7%AD%89%E5%BC%8F/#_1","title":"\u4ece\u4e0a\u4e0b\u6781\u9650\u70b9\u8bf4\u8d77","text":"<p>\u5728\u5b9e\u5206\u6790\u4e2d\u6709\u4e00\u4e2a\u91cd\u8981\u6982\u5ff5\u2014\u2014\u4e0a\u4e0b\u6781\u9650\u70b9\uff0c\u5bf9\u4e8e\u4e00\u4e2a\u65e0\u7a77\u5b9e\u6570\u5e8f\u5217\\((a_n)_{n=m}^{\\infty}\\)\uff0c\u5176\u4e0a\u6781\u9650\u70b9\u7531\u4e0b\u5b9a\u4e49 $$  L^+ = \\lim_{n \\to \\infty} \\sup a_n = \\inf_{N\\ge  m} \\sup_{n\\ge N} a_n $$ \u5bf9\u5e94\u7684\uff0c\u4e0b\u6781\u9650\u70b9\u5219\u662f $$ L^- = \\lim_{n \\to \\infty} \\inf a_n = \\sup_{N\\ge  m} \\inf_{n\\ge N} a_n $$ \u8fd9\u662f\u4e00\u4e2a\u6709\u8da3\u7684\u5b9a\u4e49\uff0c\u4ee5\u4e0a\u6781\u9650\u70b9\u4e3a\u4f8b\uff0c\u6211\u4eec\u5148\u56fa\u5b9a\u4e00\u4e2a\u8d77\u59cb\u7d22\u5f15\\(N\\)\uff0c\u7136\u540e\u4ece\\(N\\)\u671b\u5411\u9065\u8fdc\u7684\u5e8f\u5217\u8fdc\u65b9\uff0c\u5bfb\u627e\u8fd9\u4e2a\u622a\u65ad\u7684\u5e8f\u5217\u7684\u4e0a\u786e\u754c\uff0c\u5fc3\u4e2d\u9ed8\u9ed8\u8bb0\u4e0b\u5b83\u3002\u91cd\u590d\u8fd9\u4e2a\u8fc7\u7a0b\uff0c\u4e0d\u65ad\u9012\u589e\u8d77\u59cb\u7d22\u5f15\\(N\\)\uff0c\u56e0\u800c\u6536\u83b7\u4e86\u82e5\u5e72\u4e2a\u622a\u65ad\u5e8f\u5217\u7684\u4e0a\u786e\u754c\uff0c\u73b0\u5728\u518d\u5bf9\u8fd9\u4e9b\u6536\u83b7\u7684\u201c\u4e0a\u786e\u754c\u4eec\u201d\u53d6\u4e0b\u786e\u754c\uff0c\u5c31\u5f97\u5230\u4e86\u4e0a\u6781\u9650\u70b9\u3002</p> <p>\u8fd9\u4e2a\u5b9a\u4e49\u7684\u8ba1\u7b97\u8fc7\u7a0b\uff08\u5047\u60f3\u4e2d\u7684\uff0c\u56e0\u4e3a\u6211\u4eec\u65e0\u6cd5\u904d\u5386\u7d22\u5f15\uff09\u5e26\u6765\u4e86\u82e5\u5e72\u597d\u5904\uff0c\u5176\u4e2d\u4e00\u4e2a\u597d\u5904\u5c31\u662f\u53ef\u4ee5\u77e5\u9053\u5e8f\u5217\\((\\sup_{n\\ge N} a_n)_{N=m}^\\infty\\)\u662f\u5355\u8c03\u9012\u51cf\u7684\uff0c\u8fd9\u662f\u56e0\u4e3a\u968f\u7740\u6211\u4eec\u5bf9\u539f\u5e8f\u5217\u7684\u622a\u65ad\uff0c\u5bfc\u81f4\u67d0\u4e2a\u4e0a\u786e\u754c\u4e22\u6389\u4e86\uff0c\u6b63\u6240\u8c13\u201c\u960e\u738b\u4e0d\u5347\u5802\uff0c\u5c0f\u9b3c\u5148\u8d77\u4e86\u6cb9\u9505\u201d\uff0c\u4e4b\u540e\u7684\u4e0a\u786e\u754c\u5728\u66fe\u7ecf\u7684\u4e0a\u786e\u754c\u4e0b\u5e73\u5e73\u65e0\u5947\uff0c\u4f46\u662f\u5728\u622a\u65ad\u5e8f\u5217\u4e2d\u5374\u6210\u4e3a\u4e86\u4e0a\u786e\u754c\u3002</p> <p>\u540c\u7406\uff0c\u5728\u4e0b\u6781\u9650\u70b9\u7684\u8ba8\u8bba\u4e2d\u6211\u4eec\u4e5f\u80fd\u5f97\u5230\\((\\inf_{n\\ge N} a_n)_{N=m}^{\\infty}\\)\u662f\u5355\u8c03\u9012\u589e\u7684\uff0c\u4e8e\u662f\u5982\u679c\u539f\u5e8f\u5217\u6536\u655b\u7684\u8bdd\uff0c\u5c31\u53ef\u4ee5\u6709\u4e00\u4e2a\u7b80\u5355\u7684\u5939\u903c\u5173\u7cfb $$  L^- \\le L \\le L^+ $$ \u5176\u4e2d\\(L\\)\u662f\u5e8f\u5217\u7684\u6781\u9650\u3002</p>","tags":["math"]},{"location":"blog/2026/10/11/%E4%B8%8A%E4%B8%8B%E6%9E%81%E9%99%90%E7%82%B9%E4%B8%8E%E6%9C%80%E5%B0%8F%E6%9C%80%E5%A4%A7%E4%B8%8D%E7%AD%89%E5%BC%8F/#_2","title":"\u5df4\u5df4\u535a\u5f08","text":"<p>\u5728\u56de\u987e\u4e86\u4e0a\u4e0b\u6781\u9650\u70b9\u7684\u4e00\u4e9b\u6027\u8d28\u540e\uff0c\u73b0\u5728\u53ef\u4ee5\u8ba8\u8bba\u4e00\u4e2a\u6765\u81ea\u535a\u5f08\u7406\u8bba\u7684\u4e0d\u7b49\u5f0f\u2014\u2014\u6700\u5c0f\u6700\u5927\u4e0d\u7b49\u5f0f\uff0c\u5bf9\u4e8e\u4e00\u4e2a\u4e8c\u5143\u51fd\u6570\\(f: X \\times Y \\to \\mathbb{R}\\)\uff0c\u6211\u5b9a\u4e49\u5176\u610f\u4e49\u662f\u201c\u6536\u76ca\u201d\uff0c\u4e5f\u5373\u6211\u5e0c\u671b\u5b83\u8d8a\u5927\u8d8a\u597d\uff0c\u4f46\u662f\u6211\u6709\u4e00\u4e2a\u8ba8\u4eba\u538c\u7684\u5bf9\u624b\uff0c\u5b83\u4ece\u7b56\u7565\u5e93\\(Y\\)\u53d6\u51fa\\(y\\)\u8bd5\u56fe\u635f\u5bb3\u6211\u7684\u6536\u76ca\uff0c\u800c\u6211\u2014\u2014\u4e5f\u6709\u7b56\u7565\u5e93\\(X\\)\uff0c\u6211\u53d6\u51fa\u7b56\u7565\\(x\\)\u53bb\u5e94\u5bf9\uff0c\u4e8e\u662f\u4f1a\u6709\u4e0b\u9762\u7684\u4e24\u4e2a\u6545\u4e8b</p> <ul> <li> <p>\u6211\u5148\u653e\u51fa\u7b56\u7565\\(x \\in X\\)\uff0c\u5bf9\u624b\u89c2\u6d4b\u5230\u540e\u62fc\u547d\u5bfb\u627e\u6700\u574f\u7684\u7b56\u7565\\(y \\in Y\\)\uff0c\u4e8e\u662f\u6211\u5e94\u8be5\u9009\u62e9\u4e00\u4e2a\u201c\u5373\u4f7f\u5bf9\u624b\u4f7f\u574f\u4e5f\u80fd\u4e0d\u4e8f\u7684\u7b56\u7565\u201d\uff0c\u4e5f\u5373\u2014\u2014\u6211\u80fd\u4fdd\u969c\u7684\u6700\u4f4e\u6536\u76ca\\(V_{robust}\\) $$ V_{robust} = \\max_{x \\in X} \\min_{y \\in Y} f(x, y) $$</p> </li> <li> <p>\u5bf9\u624b\u5148\u653e\u51fa\u7b56\u7565\\(y \\in Y\\)\uff0c\u6211\u770b\u5230\u540e\u9009\u53d6\u4e00\u4e2a\u6700\u597d\u7684\u7b56\u7565\\(x \\in X\\)\uff0c\u5bf9\u624b\u8fdb\u800c\u9009\u62e9\u90a3\u4e2a\u80fd\u538b\u4f4e\u6211\u4e0a\u9650\u7684\u7b56\u7565\uff0c\u4e5f\u5373\u2014\u2014\u5bf9\u624b\u80fd\u628a\u6536\u76ca\u4e0a\u9650\u538b\u5230\u6700\u4f4e\u7684\u6536\u76ca\\(V_{opp}\\) $$ V_{opp} = \\min_{y \\in Y} \\max_{x \\in X} f(x, y) $$</p> </li> </ul>","tags":["math"]},{"location":"blog/2026/10/11/%E4%B8%8A%E4%B8%8B%E6%9E%81%E9%99%90%E7%82%B9%E4%B8%8E%E6%9C%80%E5%B0%8F%E6%9C%80%E5%A4%A7%E4%B8%8D%E7%AD%89%E5%BC%8F/#_3","title":"\u4ea4\u6c47\uff01","text":"<p>\u5018\u82e5\u5728\u7b2c\u4e8c\u8282\u4e2d\u7684\u4e8c\u5143\u51fd\u6570\u53d6\u4e0d\u5230\u4e00\u4e2a\u6700\u5927/\u6700\u5c0f\u503c\uff0c\u53ef\u4ee5\u8f6c\u800c\u53d6\u4e0a/\u4e0b\u786e\u754c\uff0c\u90a3\u4e48\u5728\u56de\u987e\u7b2c\u4e00\u8282\u7684\u4e0a\u4e0b\u6781\u9650\u70b9\uff0c\u6211\u4eec\u5c06\\(V_{robust}\\)\u548c\\(V_{opp}\\)\u4e2d\u7684\u6700\u5927/\u5c0f\u6362\u4f4d\u4e0a/\u4e0b\u786e\u754c\uff0c\u4e8e\u662f\u5c31\u6709 $$ V_{robust} = \\sup_{x \\in X} \\inf_{y \\in Y} f(x, y) $$ $$ V_{opp} = \\inf_{x \\in X} \\sup_{y \\in Y} f(x, y) $$  \u6700\u5c0f\u6700\u5927\u4e0d\u7b49\u5f0f\u7adf\u7136\u4e0e\u4e0a\u4e0b\u6781\u9650\u5171\u4eab\u4e00\u4e2a\u7c7b\u4f3c\u7684\u5f62\u5f0f\uff01\u4f7f\u7528\u4e0b\u9762\u7684\u8868\u683c\u7b80\u5355\u6bd4\u5bf9\u4e00\u4e0b</p> \u6700\u5c0f\u6700\u5927\u4e0d\u7b49\u5f0f \u4e0a\u4e0b\u6781\u9650 \\(f(x, y)\\) \u6309\u7167\u7d22\u5f15\u53d6\u5e8f\u5217\u7684\u67d0\u4e00\u4e2a\u503c \\(X, Y\\) \\(N \\ge m, n \\ge N\\) \\(V_{robust} \\le V_{opp}\\) \\(L^- \\le L^+\\)","tags":["math"]},{"location":"blog/2026/10/11/%E4%B8%8A%E4%B8%8B%E6%9E%81%E9%99%90%E7%82%B9%E4%B8%8E%E6%9C%80%E5%B0%8F%E6%9C%80%E5%A4%A7%E4%B8%8D%E7%AD%89%E5%BC%8F/#_4","title":"\u5982\u4f55\u53bb\u63cf\u8ff0\u8fd9\u79cd\u76f8\u4f3c\u7684\u7ed3\u6784\uff1f","text":"<p>\u6570\u5b66\u5bf9\u8c61\u4e2d\u7684\u96f7\u540c\u70b9\u5f80\u5f80\u662d\u793a\u7740\u5b83\u4eec\u4e4b\u95f4\u5b58\u5728\u67d0\u79cd\u66f4\u6df1\u5c42\u7684\u7ed3\u6784\u4e0e\u8054\u7cfb\uff0c\u53bb\u63cf\u8ff0\u8fd9\u79cd\u8fd1\u4eb2\u5173\u7cfb\u6700\u597d\u7684\u529e\u6cd5\u5c31\u662f\u627e\u7956\u5b97\uff0c\u8fd9\u4e2a\u7956\u5b97\u5e76\u4e0d\u662f\u5386\u53f2\u610f\u4e49\u4e0a\u7684\u7956\u5b97\uff0c\u800c\u662f\u7531\u7ee7\u627f\u5173\u7cfb\u786e\u5b9a\u7684\u7956\u5b97\uff0c\u719f\u6089\u9762\u5411\u5bf9\u8c61\u7684\u8bdd\uff0c\u4e5f\u8bb8\u80fd\u5199\u51fa\u8fd9\u6837\u7684python\u4ee3\u7801 <pre><code>class SharedProperty():\n    def property1(): ...\n    def property2(): ...\n\nclass MathObject1(SharedProperty):\n    @override\n    def property1():...\n\n    # def property2():...  \u6ce8\u610f\u6ca1\u6709\u5b9e\u73b0\u8fd9\u4e2a\u65b9\u6cd5\u54e6\nobj1 = MathObject1()\nobj1.property1() # \u5408\u6cd5\u7684\uff01\u56e0\u4e3a\u6211\u4eec\u53c8\u5b9e\u73b0\u4e86\u4e00\u904d\nobj1.property1() # \u4e5f\u662f\u5408\u6cd5\u7684\u2014\u2014\u8fd9\u91cc\u5047\u5b9a\u7236\u7c7b\u4e5f\u5b9e\u73b0\u5177\u4f53\u7684\u5185\u5bb9\uff0c\u800c\u4e0d\u662fNotImplementation\uff0c\u90a3\u4e48\u6b64\u5904\u7684\u884c\u4e3a\u5c31\u548c\u7236\u7c7b\u4e00\u6837\n</code></pre> \u53ef\u4ee5\u60f3\u8c61\uff0c\u5982\u679c\u4f7f\u7528\u8fd9\u79cd\u8fd9\u79cd\u7406\u89e3\uff0c\u8bb8\u591a\u5171\u540c\u7ee7\u627f\u4e86\u540c\u4e00\u7236\u7c7b\uff08\u5171\u4eab\u7edf\u4e00\u903b\u8f91\uff09\u7684\u6570\u5b66\u7ed3\u6784\u4e5f\u5b9e\u73b0\u4e86\u540c\u6837\u7684\u65b9\u6cd5\uff08\u5177\u6709\u7c7b\u4f3c\u7684\u884c\u4e3a\uff09\uff0c\u8fd9\u6216\u8bb8\u80fd\u4e3a\u8fdb\u4e00\u6b65\u7684\u63a2\u7d22\u201c\u901a\u89e3\u201d\u63d0\u4f9b\u4e00\u4e9b\u4e0d\u90a3\u4e48\u9760\u8c31\u7684\u76f4\u89c9\u3002\u4e8e\u662f\u4e4e\uff0c\u535a\u5ba2\u7cfb\u5217\u300a\u521d\u7aa5\u5bf9\u5076\u300b\u5c31\u5f00\u59cb\u5566\uff0c\u8fd9\u662f\u7b2c\u4e00\u7ae0\uff0c\u4e4b\u540e\u4f1a\u6162\u6162\u6df1\u5165\uff0c\u53bb\u8003\u8651\u8fd9\u4e9b\u73b0\u8c61\u90fd\u662f\u5982\u4f55\u5728\u66f4\u62bd\u8c61\u548c\u66f4\u6cdb\u7528\u7684\u6570\u5b66\u8bed\u8a00\u4e0b\u5f97\u5230\u7edf\u4e00</p>","tags":["math"]},{"location":"blog/archive/2026/","title":"2026","text":""}]}